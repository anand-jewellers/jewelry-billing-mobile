{
  "expo": {
    "name": "Swarnam",
    "slug": "jewelry-billing-mobile",
    "scheme": "swarnam",
    "version": "2.0.0",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan barcodes."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow $(PRODUCT_NAME) to read your contacts to fill in customer name and phone number."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 1,
          "resizeMode": "cover",
          "backgroundColor": "#0B3D91"
        }
      ],
      "react-native-image-marker"
    ],
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "SYSTEM_ALERT_WINDOW",
        "VIBRATE",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "ACCESS_FINE_LOCATION",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "READ_CONTACTS"
      ],
      "package": "com.venkat.sk.jewelrybillingmobile",
      "edgeToEdgeEnabled": true,
      "statusBar": {
        "translucent": true,
        "backgroundColor": "transparent"
      },
      "queries": [
        {
          "package": "com.whatsapp"
        },
        {
          "package": "com.whatsapp.w4b"
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ca8f4c24-eb6a-4f36-8d3f-d3fbc119e0ef"
      }
    }
  }
}